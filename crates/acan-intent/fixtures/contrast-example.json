      "surface": "http",
      "fixture": "f-alice",
      "steps": [
        {
          "step": "http",
          "id": "s1",
          "actor": "alice",
          "client": "client-a",
          "request": {
            "method": "POST",
            "path": "/api/links",
            "body": {
              "url": "https://example.test/a"
