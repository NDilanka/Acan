            }
          },
          "redirect": "manual",
          "deadline_ms": 2000
        },
        {
          "step": "http",
          "id": "s4",
          "actor": "alice",
          "client": "client-a",
          "request": {
            "method": "GET",
            "path": "/api/links"
          },
          "redirect": "manual",
          "deadline_ms": 2000
        }
      ]
    },
    "origin": "ruling",
    "route_path": {
