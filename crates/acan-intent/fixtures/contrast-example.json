            "part": "body",
            "path": "code"
          },
          "binding": "link_code",
          "kind": "identifier"
        },
        {
          "step": "http",
          "id": "s3",
          "actor": "alice",
          "client": "client-a",
          "request": {
            "method": "DELETE",
            "path": "/api/links/${link_code}",
