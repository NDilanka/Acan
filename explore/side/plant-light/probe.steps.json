[
 {"eval":"[...document.body.children].map(e=>{const r=e.getBoundingClientRect();const cs=getComputedStyle(e);return [e.tagName,e.id,(e.className&&e.className.baseVal===undefined?e.className:''),Math.round(r.left),Math.round(r.top),Math.round(r.width),Math.round(r.height),cs.display,cs.position,cs.backgroundColor].join('|')})"},
