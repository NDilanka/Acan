    "eval": "window.gateAudit = () => {\n const visible = e => e.getClientRects().length && getComputedStyle(e).visibility !== 'hidden' && +getComputedStyle(e).opacity > 0;\n const hits = (a,b) => a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;\n const issues = [];\n for (const id of ['#gateStation','#gateCard','#gateBrief']) {\n  const e = document.querySelector(id);\n  if (e.hidden || !visible(e)) continue;\n  const r = e.getBoundingClientRect();\n  if (r.left < 0 || r.top < 0 || r.right > innerWidth || r.bottom > innerHeight) issues.push(id + ' offscreen');\n  if (e.scrollHeight > e.clientHeight + 2) issues.push(id + ' scrolls');\n }\n const st = document.querySelector('#gateStation');\n if (!st.hidden) {\n  const r = st.getBoundingClientRect();\n  if (hits(r, document.querySelector('.bl').getBoundingClientRect())) issues.push('station overlaps status panel');\n  if (hits(r, document.querySelector('#cbar').getBoundingClientRect())) issues.push('station overlaps concept bar');\n  if (hits(r, document.querySelector('.hint').getBoundingClientRect())) issues.push('station overlaps hint');\n }\n const card = document.querySelector('#gateCard'), brief = document.querySelector('#gateBrief');\n if (!card.hidden && !brief.hidden && hits(card.getBoundingClientRect(), brief.getBoundingClientRect())) issues.push('card overlaps brief');\n return issues;\n}; gateAudit()",
