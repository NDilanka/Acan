    "eval": "window.clashAudit = () => {\n const visible = e => e.getClientRects().length && getComputedStyle(e).visibility !== 'hidden' && +getComputedStyle(e).opacity > 0;\n const hits = (a,b) => a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;\n const issues = [], labels = [...document.querySelectorAll('.clash-foot-label,.clash-pin-label')].filter(visible);\n const obstacles = [...document.querySelectorAll('#clashCard,#clashOrder,#clashToolbar,.chip')].filter(visible);\n labels.forEach((e,i) => {\n  const r=e.getBoundingClientRect();\n  if (r.left < 0 || r.right > innerWidth || r.top < 0 || r.bottom > innerHeight) issues.push('offscreen '+e.textContent);\n  [...labels.slice(i+1),...obstacles].forEach(o=> {if(hits(r,o.getBoundingClientRect())) issues.push(e.textContent+' overlaps '+(o.id||o.textContent));});\n });\n const card=document.querySelector('#clashCard');\n if (!card.hidden) {\n  const r=card.getBoundingClientRect();\n  if (r.left<0 || r.top<0 || r.right>innerWidth || r.bottom>innerHeight) issues.push('card offscreen');\n  if (card.scrollHeight > card.clientHeight) issues.push('card scrolls');\n }\n const plate=document.querySelector('#clashOrder');\n if (!plate.hidden) {\n  const r=plate.getBoundingClientRect();\n  [...document.querySelectorAll('.chip,.clash-pin-label')].filter(visible).forEach(e=> {if(hits(r,e.getBoundingClientRect())) issues.push('order overlaps '+e.textContent);});\n }\n return issues;\n}; clashAudit()",
